# Official Discord Bot token for channels inside servers you own or administer
DISCORD_BOT_TOKEN=

# Local SQLite WAL + FTS5 database path (stored with 0600 permissions inside 0700 directory)
RADAR_DB_PATH=.state/radar.db

# Your Discord user ID in owned channels so voice profiling indexes only your writing
RADAR_OWNER_AUTHOR_ID=

# Command or path to compiled discrawl binary for passive offline wiretap cache ingestion
DISCRAWL_BIN=discrawl

# OpenCLI Browser Bridge session name used for read only tab capture
OPENCLI_SESSION=discord-radar

# Optional Google Cloud Translation v2 API key (leave empty for keyless google_gtx mode)
GOOGLE_TRANSLATE_API_KEY=

# Optional default output language code for `brief` (for example: en, vi, ja)
RADAR_TARGET_LANG=

# Randomized daily crawl window (local HH:MM 24h range and optional IANA timezone)
RADAR_WINDOW_START=08:00
RADAR_WINDOW_END=18:00
RADAR_TIMEZONE=

# Disable background GitHub update checks during local crawls
DISCRAWL_NO_UPDATE_CHECK=1
DISCRAWL_NO_AUTO_UPDATE=1
